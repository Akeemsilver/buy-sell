rules_version = '2';
// B Ruiz Storage rules 1.02
// Paste this into Firebase console > Storage > Rules > Publish.
// 1.02 lets every member of the business (not only the account that created the store) add, read and delete the store's pictures.
// 1.01 adds the store's sharp pictures (stores/{id}/): only the store's owner can add, read or delete them; the public page uses each picture's own download link.
// Only members of a workspace can read, add or remove its photos, and only small JPEG files (the 900 px photo and the 200 px thumbnail).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isMember(w) { return signedIn() && firestore.get(/databases/(default)/documents/workspaces/$(w)).data.members[request.auth.uid] != null; }

    function storeOwner(sid) { return signedIn() && (firestore.get(/databases/(default)/documents/stores/$(sid)).data.ownerUid == request.auth.uid || ('workspace' in firestore.get(/databases/(default)/documents/stores/$(sid)).data && isMember(firestore.get(/databases/(default)/documents/stores/$(sid)).data.workspace))); }
    match /stores/{sid}/{file} {
      allow read, delete: if storeOwner(sid);
      allow write: if storeOwner(sid) && request.resource.size < 400 * 1024 && request.resource.contentType == 'image/jpeg';
    }

    match /workspaces/{w}/photos/{file} {
      allow read, delete: if isMember(w);
      allow write: if isMember(w) && request.resource.size < 400 * 1024 && request.resource.contentType == 'image/jpeg';
    }
  }
}
